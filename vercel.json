{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/portal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/remind",
      "schedule": "0 9 * * *"
    }
  ]
}